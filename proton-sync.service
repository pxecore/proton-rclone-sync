[Unit]
Description=Proton Drive Smart Sync (Local -> Proton)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Uses rclone sync to mirror local changes (including deletions)
# --max-delete 50: Prevents mass deletions in case of system loss
# --update: Only syncs if the local file is newer than the remote file
ExecStart=/usr/bin/rclone sync %h/ proton: \
    --filter-from %h/.config/rclone/proton.filter \
    --update \
    --max-delete 50 \
    --transfers 1 \
    --checkers 4 \
    --tpslimit 1 \
    --tpslimit-burst 1 \
    --drive-pacer-min-sleep 1s \
    --drive-pacer-burst 1 \
    --protondrive-replace-existing-draft=true \
    --retries 5 \
    --retries-sleep 10s \
    --low-level-retries 10 \
    --buffer-size 16M \
    --ignore-errors \
    --log-level NOTICE

Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
